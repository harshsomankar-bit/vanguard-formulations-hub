# Vanguard Formulations Hub - Environment Configuration

# Destination email where customer inquiries should be delivered
# Defaults to trade@vanguardtherapeutics.com if omitted
CONTACT_EMAIL=trade@vanguardtherapeutics.com

# Optional: Resend API Key for live email delivery
# Sign up at https://resend.com to obtain an API key
# When set, transactional emails are sent to both the client and the Trade Desk
# RESEND_API_KEY=re_123456789

# Optional: Custom webhook endpoint (Slack, Discord, Zapier, Make, CRM)
# CONTACT_WEBHOOK_URL=https://hooks.slack.com/services/...
